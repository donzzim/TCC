{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "anourvalar/eloquent-serialize": "^1.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-plugin-essentials": "^1.1",
        "bezhansalleh/filament-shield": "^4.0",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "danharrin/livewire-rate-limiting": "^2.1",
        "darkaonline/l5-swagger": "^9.0",
        "endroid/qr-code": "^6.0",
        "filament/filament": "~4.0",
        "flowframe/laravel-trend": "^0.4",
        "jeffgreco13/filament-breezy": "^3.0",
        "jenssegers/agent": "^2.6",
        "kirschbaum-development/eloquent-power-joins": "^4.2",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.13",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.11",
        "livewire/livewire": "^3.7",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^12.0",
        "spatie/laravel-permission": "^6.24"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/dusk": "^8.3",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.52",
        "lucascudo/laravel-pt-br-localization": "^2.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": [
                "database/seeders/",
                "database/Egap/seeders/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "quality": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\validate.ps1",
        "test:unit": "@php artisan test --testsuite=Unit",
        "test:coverage": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\validate.ps1 -Coverage",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=livewire-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        },
        "platform": {
            "php": "8.4.99"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
