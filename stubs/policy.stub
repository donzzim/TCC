     * Determine whether the user can delete the model.
     */
    public function delete({{ user }} $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('delete_{{ user }}');
    }

    /**
     * Determine whether the user can bulk delete.

     */
    public function deleteAny({{ user }} $user): bool
    {
        return $user->can('delete_any_{{ user }}');
    }

    /**
     * Determine whether the user can permanently delete the model.
     */
    public function forceDelete({{ user }} $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('force_delete_{{ user }}');
    }

    /**
     * Determine whether the user can permanently delete the model.
     */
    public function forceDeleteAny({{ user }} $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('force_delete_any_{{ user }}');
