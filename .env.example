APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_paulo
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12
DEBUGBAR_ENABLED=false
APP_FORCE_HTTPS=false


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emes
DB_USERNAME=root
DB_PASSWORD=

# Autenticação híbrida dos painéis EMES (EMES local ou TJES LDAP)
TJES_LDAP_ENABLED=false
TJES_LDAP_SCHEME=ldap
TJES_LDAP_HOST=
TJES_LDAP_PORT=389
TJES_LDAP_BASE_DN="ou=ID,o=tjes"
TJES_LDAP_SERVICE_DN="cn=cargainicialoid,ou=servicos,o=tjes"
TJES_LDAP_SERVICE_PASSWORD=
TJES_LDAP_TIMEOUT=5
TJES_LDAP_START_TLS=false
TJES_LDAP_REQUIRE_PORTAL_ACCESS=true


EGAP_DB_HOST=127.0.0.1
EGAP_DB_PORT=3306
EGAP_DB_DATABASE=egap
EGAP_DB_USERNAME=root
EGAP_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=array
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MOODLE_URL="http://localhost:8080"
MOODLE_TOKEN=""
MOODLE_INTEGRATION_ENABLED=false
MOODLE_STUDENT_ROLE_ID=5
MOODLE_TEACHER_ROLE_ID=3
MOODLE_ADMIN_ROLE_ID=1

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="teste@exmple.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL2_MAILER=log
MAIL2_HOST=localhost
MAIL2_PORT=1025
MAIL2_USERNAME=null
MAIL2_PASSWORD=null
# MAIL2_PASSWORD_APP=""
# MAIL2_SMTP_AUTH=true
MAIL2_ENCRYPTION=null
MAIL2_FROM_ADDRESS="emes-naoresponda@tjes.jus.br"
MAIL2_FROM_NAME="${APP_NAME}"

# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
#MAIL2_AUTH_MODE=login
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=teste@example.com
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
