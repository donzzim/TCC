{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"git.ignoreLimitWarning": true,
		"intelephense.completion.completionTimeout": 15000,
		"intelephense.analyse.completionTimeout": 15000,
		"intelephense.maxMemory": 4096,
		"intelephense.environment.phpVersion": "8.2.12",
		"intelephense.format.enable": true,
		"intelephense.diagnostics.enable": true,
		"intelephense.stubs": [
			"apache",
			"bcmath",
			"bz2",
			"calendar",
			"com",
			"ctype",
			"curl",
			"date",
			"dba",
			"dom",
			"enchant",
			"fileinfo",
			"filter",
			"ftp",
			"gd",
			"gettext",
			"gmp",
			"hash",
			"iconv",
			"imap",
			"intl",
			"json",
			"ldap",
			"libxml",
			"mbstring",
			"mysql",
			"mysqli",
			"oci8",
			"odbc",
			"openssl",
			"pcntl",
			"pcre",
			"pdo",
			"pgsql",
			"posix",
			"pspell",
			"reflection",
			"regex",
			"session",
			"simplexml",
			"sockets",
			"soap",
			"spl",
			"sqlite3",
			"ssh2",
			"standard",
			"statistics",
			"streams",
			"string",
			"syslog",
			"tidy",
			"tokenizer",
			"v8js",
			"wddx",
			"xml",
			"xmlreader",
			"xmlrpc",
			"xmlwriter",
			"yaml",
			"zip",
			"zlib"
		],
		"files.exclude": {
			"**/node_modules": true,
			"**/.git": true,
			"**/storage": true,
			"**/bootstrap/cache": true,
			"**/.env": true,
			"**/.env.example": true
		},
		"search.exclude": {
			"**/node_modules/cache": true
		}
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Listen for XDebug",
				"type": "php",
				"request": "launch",
				"port": 9003,
				"pathMappings": {
					"/var/www/html": "${workspaceFolder}"
				},
				"hostname": "0.0.0.0"
			}
		]
	}
}